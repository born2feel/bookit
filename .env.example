# Token from @BotFather. Never commit your real .env!
BOT_TOKEN=

# Admin Telegram IDs, comma-separated (get yours from @userinfobot)
ADMIN_IDS=

# SQLite locally; docker-compose overrides it with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./bookit.db

# Schedule
TIMEZONE=America/New_York
WORK_START=10:00
WORK_END=20:00
SLOT_STEP_MINUTES=30
BOOKING_HORIZON_DAYS=14

LOG_LEVEL=INFO

# docker-compose only (POSTGRES_PASSWORD is required — use a strong random value)
POSTGRES_USER=bookit
POSTGRES_PASSWORD=
POSTGRES_DB=bookit
